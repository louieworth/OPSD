# syntax=docker/dockerfile:1.7

# Use the existing CUDA/PyTorch/OPSD-compatible job image as the base. It must
# already provide the packages pinned in environment.yml and a working `git`.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG OPSD_GIT_REV
ARG CODE_PYTHON_BIN=python

ENV OPSD_ROOT=/workspace/OPSD \
    OPSD_GIT_REV=${OPSD_GIT_REV} \
    CODE_PYTHON_BIN=${CODE_PYTHON_BIN} \
    HF_HOME=/opt/huggingface

WORKDIR /workspace/OPSD
COPY . /workspace/OPSD
COPY deploy/docker/baked_code_job_entrypoint.sh /usr/local/bin/opsd-baked-code-entrypoint

# This is the only layer that contacts GitHub/Hugging Face. A token is optional
# for public upstreams and, when supplied as a BuildKit secret, is not stored in
# the image or its history. Preparation and cleanup intentionally share one RUN
# so transient source datasets and package caches never enter the final layer.
RUN --mount=type=secret,id=hf_token,required=false \
    set -eu; \
    test -n "$OPSD_GIT_REV"; \
    if [ -s /run/secrets/hf_token ]; then \
        export HF_TOKEN="$(tr -d '\r\n' < /run/secrets/hf_token)"; \
    fi; \
    bash script_code/prepare_code.sh all; \
    rm -rf \
        .cache/cuda \
        .cache/huggingface \
        .cache/pip \
        .cache/tmp \
        .cache/torch_extensions \
        .cache/triton \
        .cache/vllm \
        third_party/evalplus/.git \
        third_party/trd/.git

ENTRYPOINT ["/usr/local/bin/opsd-baked-code-entrypoint"]
CMD ["bash"]
